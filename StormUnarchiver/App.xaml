<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="StormUnarchiver.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- STORM Brand Colors -->
            <Color x:Key="StormAccent">#4CC9F0</Color>
            <Color x:Key="StormAccentDark">#3A9FC0</Color>
            <Color x:Key="StormSurface">#1A1B2E</Color>
            <Color x:Key="StormSurfaceLight">#242640</Color>
            <Color x:Key="StormSurfaceLighter">#2E3052</Color>
            <Color x:Key="StormSuccess">#4ADE80</Color>
            <Color x:Key="StormError">#F87171</Color>
            <Color x:Key="StormWarning">#FBBF24</Color>
            <Color x:Key="StormText">#E2E8F0</Color>
            <Color x:Key="StormTextDim">#94A3B8</Color>

            <SolidColorBrush x:Key="StormAccentBrush" Color="{StaticResource StormAccent}" />
            <SolidColorBrush x:Key="StormAccentDarkBrush" Color="{StaticResource StormAccentDark}" />
            <SolidColorBrush x:Key="StormSurfaceBrush" Color="{StaticResource StormSurface}" />
            <SolidColorBrush x:Key="StormSurfaceLightBrush" Color="{StaticResource StormSurfaceLight}" />
            <SolidColorBrush x:Key="StormSurfaceLighterBrush" Color="{StaticResource StormSurfaceLighter}" />
            <SolidColorBrush x:Key="StormSuccessBrush" Color="{StaticResource StormSuccess}" />
            <SolidColorBrush x:Key="StormErrorBrush" Color="{StaticResource StormError}" />
            <SolidColorBrush x:Key="StormWarningBrush" Color="{StaticResource StormWarning}" />
            <SolidColorBrush x:Key="StormTextBrush" Color="{StaticResource StormText}" />
            <SolidColorBrush x:Key="StormTextDimBrush" Color="{StaticResource StormTextDim}" />

            <!-- Additional Chip & Filter Brushes -->
            <SolidColorBrush x:Key="StormChipBgBrush" Color="#154CC9F0" />
            <SolidColorBrush x:Key="StormChipHoverBrush" Color="#254CC9F0" />
            <SolidColorBrush x:Key="StormChipPressedBrush" Color="#104CC9F0" />
            <SolidColorBrush x:Key="StormChipCheckedHoverBrush" Color="#E04CC9F0" />
            <SolidColorBrush x:Key="StormChipCheckedPressedBrush" Color="#B04CC9F0" />
            <SolidColorBrush x:Key="StormDarkBgBrush" Color="#1A1B2E" />

            <SolidColorBrush x:Key="StormFilterBgBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="StormFilterHoverBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="StormFilterCheckedBrush" Color="#304CC9F0" />
            <SolidColorBrush x:Key="StormFilterCheckedHoverBrush" Color="#404CC9F0" />

            <!-- Card Style -->
            <Style x:Key="StormCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StormSurfaceLightBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#33FFFFFF" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Accent Button Style -->
            <Style x:Key="StormAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Subtle Button Style -->
            <Style x:Key="StormSubtleButton" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource StormSurfaceLighterBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StormTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="#22FFFFFF" />
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!-- Toggle Chip Style (Single Accent Color) -->
            <Style x:Key="ToggleChipStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource StormChipBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StormAccentBrush}" />
                <Setter Property="BorderBrush" Value="#224CC9F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="ContentBorder"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormChipHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormChipPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormDarkBgBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormChipCheckedHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormDarkBgBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormChipCheckedPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormDarkBgBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormDarkBgBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filter Chip Style for Log Filters -->
            <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource StormFilterBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StormTextDimBrush}" />
                <Setter Property="BorderBrush" Value="#15FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="ContentBorder"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormFilterHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormFilterCheckedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormFilterCheckedHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource StormAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Subtle Action Button -->
            <Style x:Key="StormGhostButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{StaticResource StormTextDimBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
