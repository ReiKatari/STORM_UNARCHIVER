<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>STORM UNARCHIVER 1.0.0</AssemblyTitle>
    <Product>STORM UNARCHIVER 1.0.0</Product>
    <Company>STORM TEAM</Company>
    <Description>STORM UNARCHIVER 1.0.0</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\app.png" />
    <EmbeddedResource Include="Assets\Square44x44Logo.png" />
    <EmbeddedResource Include="Assets\Square150x150Logo.png" />
  </ItemGroup>
</Project>
